# Copy this file to .env and fill in credentials.
#   cp .env.example .env

# Pokémon Showdown (required for --mode ladder / challenge on the public server)
SHOWDOWN_USERNAME=
SHOWDOWN_PASSWORD=

# Janelia neuPrint token for MaleCNS (https://neuprint.janelia.org)
# If unset or invalid, the agent falls back to a synthetic Drosophila-like connectome.
NEUPRINT_APPLICATION_TOKEN=

# Optional overrides
# NEUPRINT_SERVER=https://neuprint.janelia.org
# NEUPRINT_DATASET=male-cns:v1.0
# SHOWDOWN_WS=wss://sim3.psim.us/showdown/websocket
