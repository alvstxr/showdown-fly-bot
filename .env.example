# Copy this file to .env in the same folder, then fill in the two Showdown lines.
# Windows:  copy .env.example .env
# Linux/macOS:  cp .env.example .env
#
# The bot stays offline until you start it with --mode ladder, challenge, or accept.
# Those modes log into play.pokemonshowdown.com using the name and password below.

# Registered Pokémon Showdown account (not a guest / "Choose name" only)
SHOWDOWN_USERNAME=
SHOWDOWN_PASSWORD=

# Optional. Leave blank. The bot uses a local synthetic connectome and does not
# contact Janelia unless you pass --neuprint AND set a token.
# NEUPRINT_APPLICATION_TOKEN=
